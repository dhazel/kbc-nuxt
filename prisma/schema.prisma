// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("NETLIFY_DATABASE_URL")
}

model User {
  id              Int     @id @default(autoincrement())
  name            String
  email           String  @unique
  joinedAt        DateTime @default(now())
  visitCount      Int     @default(0)
  prayerOrders    Int     @default(0)
  prayerResponses Int     @default(0)

  createdPrayerOrders  PrayerOrder[] @relation("PrayerOrderCreator")
  roles           Role[]
  messages        Message[]
  organizations   Organization[]

  @@map("users")
}

model Role {
  id     Int    @id @default(autoincrement())
  name   String

  users  User[]

  @@map("roles")
}

model Organization {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  prayerOrders PrayerOrder[]

  @@map("organizations")
}

model PrayerOrder {
  id                  Int       @id @default(autoincrement())
  creatorId           Int
  creator             User      @relation("PrayerOrderCreator", fields: [creatorId], references: [id])

  typeId              Int       // Required: links to thread type
  type                ThreadType @relation(fields: [typeId], references: [id])

  organizationId      Int       // Required: links to organization
  organization        Organization @relation(fields: [organizationId], references: [id])

  title               String?   // Optional subject/title for the thread
  firstMessageContent String    // Content of the original/root post
  
  messages            Message[] // All replies/follow-ups (flat)
  
  createdAt           DateTime  @default(now())
  lastActivityAt      DateTime  @default(now()) @updatedAt // Automatically updates on new messages
  
  @@index([creatorId])
  @@index([createdAt])
  @@index([typeId])  // Added for type-based queries
  @@index([organizationId])  // Added for org-based queries

  @@map("prayer_orders")
}

model Message {
  id         Int      @id @default(autoincrement())
  prayerOrderId   Int
  prayerOrder     PrayerOrder   @relation(fields: [prayerOrderId], references: [id], onDelete: Cascade)
  
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])
  
  content    String
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime? // Optional: for soft deletes
  
  @@index([prayerOrderId, createdAt(desc)]) // Critical for efficient chronological fetching + pagination
  @@index([authorId])
  @@index([deletedAt]) // Helps with soft-delete queries

   @@map("messages")
}

model ThreadType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  prayerOrders     PrayerOrder[]

  @@map("thread_types")
}
