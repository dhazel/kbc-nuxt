// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("NETLIFY_DATABASE_URL")
}

enum ReactionType {
  LIKE
  LOVE
  PRAY
  LAUGH
  CARE
  CLAP
  CELEBRATE
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  joinedAt   DateTime @default(now())
  visitCount Int      @default(0)
  mondayId   String?

  createdPrayerOrders PrayerOrder[]  @relation("PrayerOrderCreator")
  roles               Role[]
  messages            Message[]
  messageViews        MessageView[]
  messageReactions    MessageReaction[]
  userRolesPerOrganization           UserRoleInOrganization[]

  @@unique([mondayId])
  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String

  users User[]
  userRolesPerOrganization UserRoleInOrganization[]

  @@map("roles")
}

model Organization {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  prayerOrders PrayerOrder[]
  mondayBoards MondayBoard[]
  userRolesInOrganization    UserRoleInOrganization[]

  subscriptionId Int?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("organizations")
}

model UserRoleInOrganization {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  roleId         Int
  role           Role          @relation(fields: [roleId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  @@unique([userId, roleId, organizationId])
  @@map("user_roles_in_organization")
}

model Subscription {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  organizations Organization[]
  boardMappings BoardMapping[]

  @@map("subscriptions")
}

model Status {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  color               String?
  prayerOrderStatuses PrayerOrderStatus[] // Many-to-many via junction

  @@map("statuses")
}

model PrayerOrderStatus {
  prayerOrderId Int
  prayerOrder   PrayerOrder @relation(fields: [prayerOrderId], references: [id], onDelete: Cascade)
  statusId      Int
  status        Status      @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@unique([prayerOrderId, statusId]) // Prevents duplicate Statuses per PrayerOrder
  @@map("prayer_order_statuses")
}

model PrayerOrder {
  id        Int  @id @default(autoincrement())
  creatorId Int
  creator   User @relation("PrayerOrderCreator", fields: [creatorId], references: [id])

  typeId Int // Required: links to thread type
  type   IntercessionType @relation(fields: [typeId], references: [id])

  organizationId Int // Required: links to organization
  organization   Organization @relation(fields: [organizationId], references: [id])

  title               String? // Optional subject/title for the thread
  firstMessageContent String // Content of the original/root post

  messages Message[] // All replies/follow-ups (flat)

  createdAt         DateTime           @default(now())
  lastActivityAt      DateTime             @default(now()) @updatedAt // Automatically updates on new messages
  mondayId            String?
  prayerOrderStatuses PrayerOrderStatus[]

  @@index([creatorId])
  @@index([createdAt])
  @@index([typeId]) // Added for type-based queries
  @@index([organizationId]) // Added for org-based queries
  @@map("prayer_orders")
}

model Message {
  id            Int         @id @default(autoincrement())
  prayerOrderId Int
  prayerOrder   PrayerOrder @relation(fields: [prayerOrderId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  parentMessageId Int?
  parentMessage   Message? @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies         Message[] @relation("MessageReplies")

  messageViews    MessageView[]

  messageReactions MessageReaction[]

  content String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Optional: for soft deletes
  mondayId  String?

  @@index([prayerOrderId, createdAt(desc)]) // Critical for efficient chronological fetching + pagination
  @@index([authorId])
  @@index([deletedAt]) // Helps with soft-delete queries
  @@index([parentMessageId]) // Added for efficient reply querying
  @@map("messages")
}

model MessageView {
  id        Int      @id @default(autoincrement())
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime? // Optional timestamp; null for imported data without views

  @@unique([messageId, userId]) // Ensures one record per user-message (first view)
  @@index([messageId]) // Efficient querying of views for a message
  @@index([userId]) // Efficient querying of views by a user
  @@map("message_views")
}

model MessageReaction {
  id           Int          @id @default(autoincrement())
  messageId    Int
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId       Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType ReactionType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

model IntercessionType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  prayerOrders  PrayerOrder[]
  boardMappings BoardMapping[]

  @@map("intercession_types")
}

model BoardMapping {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  intercessionTypeId   Int
  intercessionType     IntercessionType   @relation(fields: [intercessionTypeId], references: [id])
  mondayBoardId  Int?
  mondayBoard    MondayBoard? @relation(fields: [mondayBoardId], references: [id])

  @@unique([subscriptionId, intercessionTypeId, mondayBoardId])
  @@map("board_mappings")
}

model MondayBoard {
  id             Int            @id @default(autoincrement())
  mondayId  String         @unique
  boardName      String?
  organizationId Int?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  boardMappings          BoardMapping[]
  mondayPrayerOrderSync   MondayPrayerOrderSync?
  createdAt               DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("monday_boards")
}

model MondayPrayerOrderSync {
  id             Int                   @id @default(autoincrement())
  mondayBoardId  Int                   @unique
  mondayBoard    MondayBoard           @relation(fields: [mondayBoardId], references: [id])
  lastSyncedAt   DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([mondayBoardId])
  @@map("monday_prayer_order_syncs")
}

model GeneralSync {
  id            Int       @id @default(autoincrement())
  description   String
  lastSyncedAt  DateTime?
  
  @@map("general_syncs")
}
